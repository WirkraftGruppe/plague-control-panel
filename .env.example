# Plantilla de variables de entorno. Copiar los valores reales al entorno; .env no se versiona ni se lee.

# Requeridas
SECRET_KEY=
# Local: development. Hosting: production (obligatorio, sin valor por defecto).
DJANGO_ENV=
DATABASE_URL=

# Requerida en producción: sin ella, toda petición da 400.
ALLOWED_HOSTS=

# Orígenes https del sitio, separados por comas (obligatorio detrás del proxy del hosting).
CSRF_TRUSTED_ORIGINS=

# Origen público (arma el contenido de los QR). Requerida en producción; local: http://localhost:8000.
SITE_URL=

# Opcionales
MEDIA_ROOT=
STORAGE_BACKEND=local
# Nombre de la empresa y correo de contacto (provisorios hasta multiempresa; vacíos: valores por defecto).
NOMBRE_EMPRESA=
CORREO_CONTACTO=
# Cantidad de proxies inversos de confianza delante de Django (entero >= 0).
# NUM_PROXIES=0
# Atraso máximo de una visita desde la app, en horas (entero entre 1 y 8760).
# ATRASO_MAXIMO_HORAS=168
# Distancia máxima entre el escaneo y el sitio o punto, en metros (entero entre 50 y 5000).
# DISTANCIA_MAXIMA_M=300

# Solo cuando STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
