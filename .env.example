# Plantilla de variables de entorno. Copiar los valores reales al entorno; .env no se versiona ni se lee.

# Requeridas
SECRET_KEY=
# Local: development. Hosting: production (obligatorio, sin valor por defecto).
DJANGO_ENV=
DATABASE_URL=

# Requerida en producción: sin ella, toda petición da 400.
ALLOWED_HOSTS=

# Orígenes https del sitio, separados por comas (obligatorio detrás del proxy del hosting).
CSRF_TRUSTED_ORIGINS=

# Origen público (arma el contenido de los QR). Requerida en producción; local: http://localhost:8000.
SITE_URL=

# Opcionales
MEDIA_ROOT=
STORAGE_BACKEND=local
# Contacto del operador de Detach (va en el User-Agent de Nominatim). Opcional, pero conviene
# definirlo en producción: sin él se usa plataforma@example.com, un correo inexistente.
CORREO_PLATAFORMA=
# Cantidad de proxies inversos de confianza delante de Django (entero >= 0).
# NUM_PROXIES=0
# Atraso máximo de una visita cargada a mano en el panel, en horas (entero entre 1 y 8760).
# ATRASO_MAXIMO_HORAS=168
# Atraso máximo de lo que manda la app trabajando sin conexión, en horas (entero entre 1 y 8760).
# ATRASO_MAXIMO_APP_HORAS=72
# Horas desde la apertura tras las que el cierre nocturno cierra una visita aunque tenga
# actividad reciente (entero entre 1 y 8760).
# VISITA_ABIERTA_TOPE_HORAS=36
# Distancia máxima entre el escaneo y el sitio o punto, en metros (entero entre 50 y 5000).
# DISTANCIA_MAXIMA_M=300

# Solo cuando STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
